# Mars Habitat Service — local environment
#
# Copy this file to .env, then complete the Mission Control handshake
# (see README.md → Stage 1) to retrieve your DATABASE_URL.

# Backend — Mars Command will issue this value via the handshake response.
# Leave blank until you have completed the handshake.
DATABASE_URL=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
